{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LumiOpen/env-review/raw/main/schemas/dataset.schema.json",
  "title": "Dataset review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source", "review_status", "task_identity"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^(hf|gh):[^/\\s:]+/[^/\\s:]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url", "revision"],
      "properties": {
        "provider": {"enum": ["huggingface", "github"]},
        "url": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "review_status": {"enum": ["exploring", "queued"]},
    "task_identity": {"type": "object", "additionalProperties": true},
    "notes": {"type": "string"}
  }
}
