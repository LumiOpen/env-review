{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LumiOpen/env-review/raw/main/schemas/finding.schema.json",
  "title": "Environment review finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "dataset", "revision", "title", "status", "category", "tasks", "problem", "evidence", "validation", "provenance"],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^\\u0000]+$"
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^ER-[0-9a-f]{8}$"},
    "dataset": {"type": "string", "pattern": "^(hf|gh):[^/\\s:]+/[^/\\s:]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "title": {"$ref": "#/$defs/text"},
    "status": {"enum": ["candidate", "confirmed", "behavior_only", "disputed", "rejected", "fixed"]},
    "category": {"enum": ["specification", "environment_specification", "answer_exposure", "constraint_enforcement", "grader_mismatch", "incorrect_reference", "unreachable", "reward_shortcut", "scoring", "infrastructure", "other"]},
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "config": {"$ref": "#/$defs/text"},
          "split": {"$ref": "#/$defs/text"},
          "row_index": {"type": "integer", "minimum": 0},
          "path": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "problem": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "expected", "actual"],
      "properties": {
        "description": {"$ref": "#/$defs/text"},
        "expected": {"$ref": "#/$defs/text"},
        "actual": {"$ref": "#/$defs/text"}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "quote"],
        "dependentRequired": {"line_end": ["line_start"]},
        "properties": {
          "source": {"$ref": "#/$defs/relativePath"},
          "quote": {"$ref": "#/$defs/text"},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "json_pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"},
          "note": {"type": "string"}
        }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "summary", "assumptions", "not_run"],
      "properties": {
        "method": {"enum": ["static", "reproduction", "manual_review"]},
        "summary": {"$ref": "#/$defs/text"},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "not_run": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "reproducer": {"$ref": "#/$defs/text"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["discovered_by"],
      "properties": {
        "discovered_by": {"$ref": "#/$defs/text"},
        "experiment": {"$ref": "#/$defs/text"}
      }
    },
    "discussion": {"type": "string"}
  }
}
