{
 "cwd": "/work/workspace",
 "uploads": [
  {
   "source": "workspace",
   "target": "/work/workspace",
   "container": "main"
  },
  {
   "source": "system",
   "target": "/work/system",
   "container": "sidecar"
  },
  {
   "source": "tools",
   "target": "/work/tools",
   "container": "sidecar"
  },
  {
   "source": "sidecar_entrypoint.py",
   "target": "/installed-agent/sidecar_entrypoint.py",
   "container": "sidecar"
  },
  {
   "source": "mcp_http.py",
   "target": "/installed-agent/mcp_http.py",
   "container": "sidecar"
  },
  {
   "source": "mcp_bridge.py",
   "target": "/work/_setup/mcp_bridge.py",
   "container": "main"
  }
 ],
 "setup": {
  "command": "python3 /installed-agent/sidecar_entrypoint.py --start-and-detach",
  "container": "sidecar",
  "timeout_sec": 300
 },
 "wait_ports": [
  39101,
  39102,
  39103,
  39104,
  39105,
  39106
 ],
 "mcp_servers": [
  {
   "name": "adyen_dispute_operations",
   "url": "http://127.0.0.1:39101/mcp"
  },
  {
   "name": "northstar_rule_tuning_lab",
   "url": "http://127.0.0.1:39102/mcp"
  },
  {
   "name": "salesforce_fraud_case_console",
   "url": "http://127.0.0.1:39103/mcp"
  },
  {
   "name": "servicenow_risk_governance",
   "url": "http://127.0.0.1:39104/mcp"
  },
  {
   "name": "sift_fraud_control_center",
   "url": "http://127.0.0.1:39105/mcp"
  },
  {
   "name": "stripe_payments_ledger",
   "url": "http://127.0.0.1:39106/mcp"
  }
 ],
 "verifier": {
  "uploads": [
   {
    "source": "verify.py",
    "target": "/work/verify.py"
   },
   {
    "source": "verifier_meta.json",
    "target": "/work/verifier_meta.json"
   },
   {
    "source": "_helpers.py",
    "target": "/work/_helpers.py"
   },
   {
    "source": "run_verify.py",
    "target": "/work/run_verify.py"
   }
  ],
  "command": "python3 /work/run_verify.py",
  "reward_file": "/logs/verifier/reward.json",
  "reward_detail_file": "/logs/verifier/reward_detail.json",
  "timeout_sec": null,
  "env_passthrough": null
 }
}